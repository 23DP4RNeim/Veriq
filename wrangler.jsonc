{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "veriq",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-20",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "NODE_ENV": "production",
    "COMPANY_PROVIDER": "ur_open_data",
    "LOG_LEVEL": "info",
    "RATE_LIMIT_REQUESTS": "20",
    "RATE_LIMIT_WINDOW_SECONDS": "3600"
  },
  "ratelimits": [{ "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } }],
  // After creating Hyperdrive with the Supabase CA (see deployment guide), add:
  // "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "YOUR_HYPERDRIVE_ID" }],
  "observability": { "enabled": true }
}
