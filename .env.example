NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# For cloud deployment, use the Supabase Connect > Transaction pooler URL.
# postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=verify-full
# URL-encode special characters in the password. Never put this URL in admin.html.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/veriq?schema=public
# Use mock for fictional fixtures or ur_open_data after `npm run data:sync:ur`.
COMPANY_PROVIDER=mock
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=
# Required online: generate with `openssl rand -hex 32` and store as a Worker secret.
ADMIN_TOKEN=
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=3600
LOG_LEVEL=info
CORS_ORIGINS=
